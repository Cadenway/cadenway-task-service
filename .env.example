# Local values that work with `docker compose -f compose.dev.yaml up -d`.
# Copy this file to .env for local work; .env is never committed.
# When 5432 or 4222 is taken on the host, start the stack with DEV_POSTGRES_PORT / DEV_NATS_PORT set
# and use the same ports below.

# Port of the internal HTTP API.
PORT=3013

# This service's own PostgreSQL database (local development credentials of compose.dev.yaml).
DATABASE_URL=postgres://task:task@localhost:5432/task

# NATS JetStream broker, reached through @waypoint/nest-messaging.
NATS_URL=nats://localhost:4222
